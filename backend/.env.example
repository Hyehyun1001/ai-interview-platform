# 복사해서 backend/.env 로 사용 (커밋 금지, chmod 600) — 항목 정의는 docs/TRD.md §8.2
APP_ENV=dev                         # dev | prod
ALLOWED_ORIGINS=http://localhost:3000
MAX_CONCURRENT_SESSIONS=1

# 필수: 누락 시 기동 거부
JWT_SECRET=                         # 32자 이상 무작위 문자열:  python -c "import secrets;print(secrets.token_urlsafe(48))"
DATA_ENCRYPTION_KEY=                # Fernet 키:  python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=7
WS_TOKEN_TTL_SEC=60

# ── AI 파이프라인 (기본값은 TRD §8.2 / M0 확정값) ──
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M
OLLAMA_KEEP_ALIVE=30m
LLM_TIMEOUT_S=8
LLM_NUM_CTX=6144                    # REPORT_NUM_CTX 와 같게 유지 (다르면 Ollama 가 모델을 다시 로드해 번갈아 호출할 때마다 +약 10초)
RESUME_EXTRACT_NUM_PREDICT=1536     # 이력서 구조화 추출의 출력 토큰 한도
RESUME_EXTRACT_TIMEOUT_S=90
EMBED_MODEL=BAAI/bge-m3
EMBED_DEVICE=mps
EMBED_KEEP_RESIDENT=auto            # auto | true | false
STT_ENGINE=faster-whisper
STT_MODEL=large-v3-turbo
STT_COMPUTE_TYPE=int8
STT_CPU_THREADS=6                   # M2 Pro 성능 코어 수 (M0 실측)
TTS_PROVIDER=local                  # local(오프라인) | edge(외부 전송, opt-in — 아직 미구현)
TTS_VOICE=Yuna
# ── 코딩테스트 샌드박스 (TRD §5, §8.2): 켜려면 Docker + `backend/sandbox/build.sh` 로 이미지를 먼저 빌드 ──
SANDBOX_ENABLED=false
SANDBOX_TIME_LIMIT_SEC=3
SANDBOX_MEMORY_MB=128
# MEDIA_ROOT=<저장소>/data/media    # 음성·영상 (gitignore 대상)
# CHROMA_PATH=<저장소>/data/chroma

# 기본값: <저장소>/data/dev.db (SQLite). 운영: postgresql+asyncpg://user:***@127.0.0.1:5432/interview
# DATABASE_URL=sqlite+aiosqlite:///./data/dev.db
