# docker-compose.yml 용 (루트 .env, 커밋 금지). 백엔드 설정은 backend/.env.example 참고.
POSTGRES_USER=interview
POSTGRES_PASSWORD=            # 필수: 임의의 강한 값  python -c "import secrets;print(secrets.token_urlsafe(24))"
POSTGRES_DB=interview
POSTGRES_PORT=5432

# backend/.env 에 넣을 DATABASE_URL (비밀번호의 특수문자는 URL 인코딩):
#   DATABASE_URL=postgresql+asyncpg://interview:<POSTGRES_PASSWORD>@127.0.0.1:5432/interview
# 백엔드 pytest 를 PostgreSQL 에서 돌릴 때 (테스트마다 임시 DB 를 만들고 지운다 — 생성 권한이 있는 계정 필요):
#   TEST_DATABASE_URL=postgresql+asyncpg://interview:<POSTGRES_PASSWORD>@127.0.0.1:5432/postgres
